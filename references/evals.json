{
  "skill_name": "eval-core-pack",
  "version": "1.0.0",
  "evals": [
    {
      "id": 1,
      "type": "capability",
      "trials": 3,
      "grader_aggregation": "average",
      "prompt": "Evaluate the skill at ./test-samples/well-written-skill using eval-skill-quality",
      "expected_output": "A report with 5 dimension scores between 1-5, letter grade, and improvement suggestions",
      "assertions": [
        "Output contains all 5 sub_dimension scores",
        "Each dimension score is between 1 and 5",
        "Letter grade is A, B, C, D, or F",
        "Overall score is between 0 and 100"
      ],
      "graders": [
        {
          "type": "model",
          "weight": 1.0,
          "rubric": "skills/eval-skill-quality/references/skill-quality-rubric.yaml",
          "assertions": [
            "Output contains all 5 sub_dimension scores",
            "Each dimension score is between 1 and 5",
            "Letter grade is A, B, C, D, or F",
            "Overall score is between 0 and 100"
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "regression",
      "trials": 3,
      "grader_aggregation": "average",
      "prompt": "Evaluate the skill at ./test-samples/known-bad-skill using eval-skill-quality",
      "expected_output": "Score below 50, letter grade D or F, critical security issue flagged",
      "assertions": [
        "Overall score < 50",
        "Security sub-dimension scored 1 or 2",
        "Verdict is REJECT",
        "Improvement suggestions present"
      ],
      "graders": [
        {
          "type": "model",
          "weight": 1.0,
          "rubric": "skills/eval-skill-quality/references/skill-quality-rubric.yaml",
          "assertions": [
            "Overall score < 50",
            "Security sub-dimension scored 1 or 2",
            "Verdict is REJECT",
            "Improvement suggestions present"
          ]
        }
      ]
    },
